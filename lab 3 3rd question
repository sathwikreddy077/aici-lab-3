#generate a code for amstrong number
def is_armstrong(num):
    # Convert the number to string to iterate over each digit
    str_num = str(num)
    # Calculate the number of digits
    num_digits = len(str_num)
    # Calculate the sum of each digit raised to the power of num_digits
    sum_of_powers = sum(int(digit) ** num_digits for digit in str_num)
    # Check if the sum of powers is equal to the original number
    return sum_of_powers == num
# Test the function
test_number = int(input("Enter a number to check if it is an Armstrong number: "))
if is_armstrong(test_number):
    print(f"{test_number} is an Armstrong number.")
else:
    print(f"{test_number} is not an Armstrong number.")